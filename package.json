{
  "name": "stepwise-mcp",
  "version": "0.1.0",
  "description": "Live API Debugger Agent built with Model Context Protocol (MCP)",
  "main": "agent/src/index.js",
  "type": "module",
  "scripts": {
    "start": "node agent/src/index.js",
    "start:dev": "NODE_ENV=development node agent/src/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:integration": "vitest --include '**/integration/**'",
    "test:e2e": "vitest --include '**/e2e/**'",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "mcp:gladia": "node mcp-servers/gladia/src/server.js",
    "mcp:honeyhive": "python mcp-servers/honeyhive/src/server.py",
    "mcp:horizon3": "node mcp-servers/horizon3/src/server.js",
    "mcp:custom-api": "node mcp-servers/custom-api/src/server.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "setup": "npm install && python -m pip install -r requirements.txt"
  },
  "keywords": [
    "mcp",
    "api-debugging",
    "e2b",
    "docker",
    "observability",
    "security-scanning"
  ],
  "author": "Stepwise Team",
  "license": "MIT",
  "dependencies": {
    "@e2b/code-interpreter": "^2.0.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "openai": "^4.24.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.0",
    "pino": "^8.14.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
