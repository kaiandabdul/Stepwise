# Stepwise MCP Project - Environment Configuration Example
# Copy this file to .env and fill in your actual API keys
# DO NOT commit the .env file to git - it contains secrets!

################################################################################
# REQUIRED API KEYS
################################################################################

# E2B - Cloud Sandbox Service
# Get your API key from: https://e2b.dev/docs/getting-started
E2B_API_KEY=your_e2b_api_key_here

# Gladia - Speech-to-Text API
# Get your API key from: https://www.gladia.io/
GLADIA_API_KEY=your_gladia_api_key_here

# HoneyHive - AI Observability Platform
# Get your API key from: https://www.honeyhive.ai/
HONEYHIVE_API_KEY=your_honeyhive_api_key_here
HONEYHIVE_PROJECT=stepwise-agent

# LLM Provider - At least ONE is required
# Option 1: OpenAI (GPT-3.5-turbo, GPT-4, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

################################################################################
# OPTIONAL API KEYS
################################################################################

# Horizon3.ai - Security Scanning
# Get your API key from: https://horizon3.ai/
# If not set, can use mock mode with HORIZON3_USE_MOCK=true
HORIZON3_API_KEY=your_horizon3_api_key_here
HORIZON3_USE_MOCK=false

################################################################################
# E2B CONFIGURATION
################################################################################

# E2B Template ID - Created during Phase 3
# This will be set after building the E2B template
# Run: cd e2b-template && e2b template build --name stepwise-debugger
E2B_TEMPLATE_ID=your_template_id_here

# Whether to use E2B for sandbox execution
# Set to false for local development without E2B sandboxes
USE_E2B=true

################################################################################
# OPTIONAL SETTINGS
################################################################################

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Development mode
NODE_ENV=development

# API Port for Agent
AGENT_PORT=3000

# Gradio Frontend Port
GRADIO_PORT=7860

################################################################################
# MCP SERVER URLS (Local Development)
################################################################################

# These are the default ports for local MCP servers
GLADIA_MCP_URL=http://localhost:8000
HONEYHIVE_MCP_URL=http://localhost:8001
HORIZON3_MCP_URL=http://localhost:8002
CUSTOM_API_MCP_URL=http://localhost:8003

################################################################################
# DEVELOPMENT FLAGS
################################################################################

# Set to false to run locally without E2B sandboxes
USE_E2B=true

# Use mock Horizon3 data (set to true if API unavailable)
HORIZON3_USE_MOCK=false

# Ensure Python output is unbuffered
PYTHONUNBUFFERED=1
